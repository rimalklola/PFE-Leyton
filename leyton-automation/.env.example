# ─────────────────────────────────────────────────────────────────────────────
# Leyton Automation Platform — Environment Configuration
#
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to version control — it is in .gitignore.
#
# Usage:
#   cp .env.example .env
#   docker-compose --env-file .env up -d
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# ── API ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Database ─────────────────────────────────────────────────────────────────
# Local dev: relative path works fine.
# Production (Railway): use /data/runs.db (persistent volume mounted at /data).
DATABASE_PATH=./runs.db

# ── Monitoring ───────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=leyton2026   # change in production
PROMETHEUS_RETENTION=30d

# ── Deployment (filled automatically by CI/CD — do not set manually) ─────────
# RAILWAY_TOKEN=                   # set as a GitHub Actions secret, not here
# GITHUB_SHA=                      # injected by GitHub Actions
