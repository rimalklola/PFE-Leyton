{
  "name": "handover-generator",
  "version": "2.0.0",
  "description": "Fill in mission details and get a structured handover document ready to pass to the incoming consultant.",
  "icon": "fas fa-handshake",
  "tags": ["handover", "document", "mission"],
  "input_type": "form",
  "supports_extract": true,
  "extract_accept": ".xlsx,.xls",
  "timeout": 60,
  "fields": [
    { "name": "client_name",          "label": "Client Name *",             "type": "text",     "required": true,  "placeholder": "e.g. Acme Industries" },
    { "name": "outgoing_consultant",  "label": "Outgoing Consultant *",     "type": "text",     "required": true,  "placeholder": "Full name" },
    { "name": "incoming_consultant",  "label": "Incoming Consultant *",     "type": "text",     "required": true,  "placeholder": "Full name" },
    { "name": "sales_contact",        "label": "Sales Contact",             "type": "text",     "required": false, "placeholder": "Full name" },
    { "name": "mission_type",         "label": "Mission Type *",            "type": "select",   "required": true,
      "options": ["CIR", "BELSPO", "CII", "JEI", "Other"] },
    { "name": "mission_start",        "label": "Mission Start Year",        "type": "number",   "required": false, "placeholder": "2025" },
    { "name": "sector",               "label": "Sector of Activity",        "type": "text",     "required": false, "placeholder": "e.g. Manufacturing, Software, Pharma" },
    { "name": "company_type",         "label": "Type of Company",           "type": "select",   "required": false,
      "options": ["PME / KMO", "Grande Entreprise", "Start-up", "Association / ASBL", "Other"] },
    { "name": "account_history",      "label": "Account History",           "type": "textarea", "required": false, "placeholder": "Client since, segment, previous missions..." },
    { "name": "belspo_vat",           "label": "Belspo VAT Number",         "type": "text",     "required": false, "placeholder": "BE0839622201" },
    { "name": "belspo_password",      "label": "Belspo Password",           "type": "text",     "required": false, "placeholder": "Portal password" },
    { "name": "belspo_notification",  "label": "Belspo Notification Info",  "type": "textarea", "required": false, "placeholder": "Program, projects, coverage date..." },
    { "name": "previous_control",     "label": "Previous Control",          "type": "text",     "required": false, "placeholder": "e.g. No previous control" },
    { "name": "remuneration_system",  "label": "Remuneration System",       "type": "text",     "required": false, "placeholder": "e.g. Fixed fee 12%" },
    { "name": "gdpr",                 "label": "GDPR",                      "type": "select",   "required": false,
      "options": ["OK", "Pending", "N/A"] },
    { "name": "technical_contact",    "label": "Technical Contact",         "type": "text",     "required": false, "placeholder": "Name, email, phone" },
    { "name": "hr_contact",           "label": "HR Contact",                "type": "text",     "required": false, "placeholder": "Name, email, phone" },
    { "name": "social_secretary",     "label": "Social Secretary",          "type": "text",     "required": false, "placeholder": "e.g. SD Worx / contact email" },
    { "name": "folder_link",          "label": "Client Folder (SharePoint / URL)", "type": "url", "required": false, "placeholder": "https://leyton.sharepoint.com/..." },
    { "name": "network_path",         "label": "Network Drive Path",        "type": "text",     "required": false, "placeholder": "\\\\server\\Clients\\ClientName\\" },
    { "name": "key_contacts",         "label": "Key Client Contacts",       "type": "textarea", "required": false, "placeholder": "Name, role, email — one per line" },
    { "name": "pending_tasks",        "label": "Pending Tasks / Next Steps","type": "textarea", "required": false, "placeholder": "Task 1\nTask 2" },
    { "name": "notes",                "label": "Important Notes",           "type": "textarea", "required": false, "placeholder": "Anything the incoming consultant must know" }
  ],
  "output": {
    "type": "xlsx",
    "description": "Structured handover document"
  }
}
